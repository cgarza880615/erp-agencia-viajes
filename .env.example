# Copia este archivo a .env (mismo directorio) y llena tus propios valores.
# .env nunca debe compartirse ni subirse al repositorio — contiene tus llaves.

# --- Asistente IA (obligatorio para que el widget funcione) ---
# Cuenta gratuita en https://console.groq.com/keys
GROQ_API_KEY=...

# --- WhatsApp Business (Meta Cloud API) — opcional ---
# Deja estas tres vacías para desactivar el módulo de WhatsApp, o pon HIDE_WHATSAPP=1
# más abajo. Se generan en Meta Business Settings → Usuarios del sistema → Generar token.
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_VERIFY_TOKEN=

# --- Módulo de WhatsApp ---
# Pon esta variable en 1 para ocultar el módulo por completo (recomendado si no
# vas a configurar WhatsApp).
HIDE_WHATSAPP=1
